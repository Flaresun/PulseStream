# Copy this file to .env on the deployment host and fill in real values.
# .env is gitignored — never commit real secrets.

# --- S3 (HLS cache storage) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- Local scratch space for HLS transcoding inside the container ---
HLS_TEMP_DIR=/tmp/hls_processing

# --- Neon Postgres ---
# From your Neon project dashboard, use the *pooled* connection string
# (goes through Neon's PgBouncer) so we don't exhaust Neon's connection
# limit alongside our own psycopg AsyncConnectionPool. Must include
# sslmode=require — Neon rejects unencrypted connections.
DATABASE_URL=postgresql://<user>:<password>@<neon-pooled-host>/<dbname>?sslmode=require

# --- yt-dlp / YouTube bot-detection workarounds ---
# Changing these only needs a container restart, not an image rebuild.
#
# Which YouTube player clients to use. Defaults to cookie-less clients that
# need neither a PO token nor the JS player — the smallest request footprint,
# which matters on datacenter IPs (AWS etc.) where web_* clients get hit with
# "Sign in to confirm you're not a bot". Run this to see valid client names:
#   python -c "from yt_dlp.extractor.youtube._base import INNERTUBE_CLIENTS; print(list(INNERTUBE_CLIENTS))"
YTDLP_PLAYER_CLIENTS=visionos,android_vr

# Set to true to send ytdlp_cookies.txt with requests. Off by default: the
# clients above ignore cookies anyway, and sending account cookies from a
# datacenter IP is itself a bot signal (and risks the account being banned).
YTDLP_USE_COOKIES=false

# Residential proxy for yt-dlp's YouTube requests. Required on AWS/any cloud
# host: YouTube blocks datacenter IPs at the player-request stage no matter
# what client or cookies you use. Leave unset locally to connect directly.
#
# MUST be a *residential* proxy — datacenter proxies are even more flagged
# than AWS itself and will fail identically.
#
# Budget ~5MB per newly-cached song (this proxies the media download too,
# since YouTube's stream URLs are IP-locked). S3 caches each song afterward,
# so a song only costs proxy bandwidth once.
# YTDLP_PROXY=http://<user>:<password>@<host>:<port>
