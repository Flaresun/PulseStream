# Copy this file to .env on the deployment host and fill in real values.
# .env is gitignored — never commit real secrets.

# --- S3 (HLS cache storage) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- Local scratch space for HLS transcoding inside the container ---
HLS_TEMP_DIR=/tmp/hls_processing

# --- Neon Postgres ---
# From your Neon project dashboard, use the *pooled* connection string
# (goes through Neon's PgBouncer) so we don't exhaust Neon's connection
# limit alongside our own psycopg AsyncConnectionPool. Must include
# sslmode=require — Neon rejects unencrypted connections.
DATABASE_URL=postgresql://<user>:<password>@<neon-pooled-host>/<dbname>?sslmode=require
